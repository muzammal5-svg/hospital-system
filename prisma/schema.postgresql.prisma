generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   // ADMIN, RECEPTIONIST, DOCTOR, ACCOUNTANT
  doctorId     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HospitalProfile {
  id                         String   @id @default("default")
  name                       String   @default("Naseem Ijaz Hospital")
  tagline                    String   @default("Excellence in Compassionate Healthcare")
  city                       String   @default("Lahore")
  address                    String   @default("Plot 14-B, Medical Enclave, Jail Road, Lahore, Pakistan")
  phone                      String   @default("+92 42 3578 9000")
  emergencyPhone             String   @default("+92 42 3578 9999")
  email                      String   @default("info@naseemijazhospital.pk")
  website                    String   @default("https://naseemijazhospital.pk")
  logoUrl                    String?
  receiptHeader              String   @default("Naseem Ijaz Hospital - Lahore\nOfficial Patient Token & Fee Receipt")
  receiptFooter              String   @default("Thank you for visiting. Emergency: +92 42 3578 9999\nValid on date of issue only.")
  prescriptionHeader         String   @default("NASEEM IJAZ HOSPITAL\nDepartment of Outpatient Services | Jail Road, Lahore")
  prescriptionFooter         String   @default("For queries & appointments: +92 42 3578 9000 | In case of emergency visit ER immediately.")
  tokenResetTime             String   @default("00:00")
  maxDiscountApprovalPercent Float    @default(20.0)
  updatedAt                  DateTime @updatedAt
}

model Department {
  id          String        @id @default(cuid())
  name        String
  nameUrdu    String?
  code        String        @unique
  description String?
  icon        String        @default("Stethoscope")
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  doctors     Doctor[]
  visits      Visit[]
  appointments Appointment[]
}

model Doctor {
  id            String           @id @default(cuid())
  name          String
  nameUrdu      String?
  qualification String
  specialty     String
  departmentId  String
  fee           Float
  roomNo        String
  phone         String?
  email         String?
  bio           String?
  photoUrl      String?
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  department    Department       @relation(fields: [departmentId], references: [id])
  schedules     DoctorSchedule[]
  visits        Visit[]
  appointments  Appointment[]
  prescriptions Prescription[]
}

model DoctorSchedule {
  id                  String   @id @default(cuid())
  doctorId            String
  dayOfWeek           Int      // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  startTime           String   // e.g. "09:00"
  endTime             String   // e.g. "14:00"
  slotDurationMinutes Int      @default(15)
  maxPatients         Int      @default(30)
  doctor              Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Patient {
  id                   String        @id @default(cuid())
  mrNumber             String        @unique // NIH-YYYY-000001
  fullName             String
  fatherOrHusbandName  String?
  age                  Int?
  dob                  DateTime?
  gender               String        // MALE, FEMALE, OTHER
  cnic                 String?       // 12345-1234567-1
  mobile               String        // 03XX-XXXXXXX
  address              String?
  city                 String        @default("Lahore")
  bloodGroup           String?       // A+, A-, B+, B-, AB+, AB-, O+, O-, UNKNOWN
  emergencyContact     String?
  allergies            String?
  photoUrl             String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  visits               Visit[]
  appointments         Appointment[]
  prescriptions        Prescription[]
  bills                Bill[]
}

model Visit {
  id                 String         @id @default(cuid())
  visitNumber        String         @unique // VIS-2026-000001
  patientId          String
  doctorId           String
  departmentId       String
  tokenNumber        Int            // Daily token per doctor
  tokenDate          String         // YYYY-MM-DD
  visitType          String         @default("OPD") // OPD, EMERGENCY, ADMISSION, FOLLOWUP
  status             String         @default("WAITING") // WAITING, IN_CONSULTATION, COMPLETED, CANCELLED
  priority           String         @default("NORMAL") // NORMAL, EMERGENCY
  consultationFee    Float
  discountAmount     Float          @default(0.0)
  discountReason     String?
  discountApprovedBy String?
  netAmount          Float
  paymentStatus      String         @default("PAID") // PENDING, PAID, PARTIAL, REFUNDED
  paymentMethod      String         @default("CASH") // CASH, CARD, JAZZCASH, EASYPAISA
  receptionUserId    String?
  calledAt           DateTime?
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  patient            Patient        @relation(fields: [patientId], references: [id])
  doctor             Doctor         @relation(fields: [doctorId], references: [id])
  department         Department     @relation(fields: [departmentId], references: [id])
  prescriptions      Prescription[]
  bills              Bill[]
}

model Appointment {
  id              String      @id @default(cuid())
  referenceNo     String      @unique // APT-2026-0001
  patientId       String?
  patientName     String
  patientMobile   String
  patientCnic     String?
  doctorId        String
  departmentId    String
  appointmentDate String      // YYYY-MM-DD
  timeSlot        String      // "09:30 AM"
  type            String      @default("ONLINE") // ONLINE, WALK_IN, PHONE
  status          String      @default("CONFIRMED") // CONFIRMED, CANCELLED, ATTENDED, NO_SHOW
  notes           String?
  reminderSent    Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  patient         Patient?    @relation(fields: [patientId], references: [id])
  doctor          Doctor      @relation(fields: [doctorId], references: [id])
  department      Department  @relation(fields: [departmentId], references: [id])

  @@unique([doctorId, appointmentDate, timeSlot])
}

model Prescription {
  id               String             @id @default(cuid())
  visitId          String
  patientId        String
  doctorId         String
  diagnosis        String
  symptoms         String?
  clinicalNotes    String?
  bloodPressure    String?
  pulse            String?
  temperature      String?
  weight           String?
  oxygenSaturation String?
  followUpDate     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  visit            Visit              @relation(fields: [visitId], references: [id])
  patient          Patient            @relation(fields: [patientId], references: [id])
  doctor           Doctor             @relation(fields: [doctorId], references: [id])
  items            PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  medicineName   String
  dosage         String       // e.g. "500mg"
  frequency      String       // e.g. "1-0-1" or "TDS"
  duration       String       // e.g. "5 days"
  instructions   String?      // e.g. "After meal"
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model Medicine {
  id          String  @id @default(cuid())
  name        String  @unique
  genericName String?
  category    String?
  dosageForm  String?
  commonDosage String?
}

model Bill {
  id              String     @id @default(cuid())
  invoiceNo       String     @unique // INV-2026-0001
  visitId         String?
  patientId       String
  subtotal        Float
  discount        Float      @default(0.0)
  tax             Float      @default(0.0)
  total           Float
  paidAmount      Float
  balance         Float      @default(0.0)
  paymentMethod   String     @default("CASH") // CASH, CARD, JAZZCASH, EASYPAISA
  paymentStatus   String     @default("PAID") // PAID, PARTIAL, UNPAID, REFUNDED
  receptionUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  patient         Patient    @relation(fields: [patientId], references: [id])
  visit           Visit?     @relation(fields: [visitId], references: [id])
  items           BillItem[]
  refunds         Refund[]
}

model BillItem {
  id          String @id @default(cuid())
  billId      String
  itemType    String // CONSULTATION, LAB, RADIOLOGY, PROCEDURE, OTHER
  description String
  quantity    Int    @default(1)
  unitPrice   Float
  amount      Float
  bill        Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model Refund {
  id          String   @id @default(cuid())
  billId      String
  amount      Float
  reason      String
  approvedBy  String?
  processedBy String?
  createdAt   DateTime @default(now())
  bill        Bill     @relation(fields: [billId], references: [id])
}

model DailyCashClosing {
  id                 String   @id @default(cuid())
  receptionistId     String
  receptionistName   String
  date               String   // YYYY-MM-DD
  openingCash        Float    @default(0.0)
  cashCollected      Float    @default(0.0)
  cardCollected      Float    @default(0.0)
  jazzCashCollected  Float    @default(0.0)
  easypaisaCollected Float    @default(0.0)
  refundsTotal       Float    @default(0.0)
  totalExpected      Float    @default(0.0)
  actualHandover     Float    @default(0.0)
  discrepancy        Float    @default(0.0)
  notes              String?
  closedAt           DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  role      String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, RESOLVED
  createdAt DateTime @default(now())
}

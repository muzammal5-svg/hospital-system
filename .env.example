# ==============================================================================
# Naseem Ijaz Hospital - Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL for Production / Docker, SQLite for zero-config local dev)
# Docker / Production:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hospital_db?schema=public"
# Local development fallback (if not running local postgres):
# DATABASE_URL="file:./dev.db"

# NextAuth Authentication
NEXTAUTH_SECRET="hospital-super-secret-jwt-key-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Naseem Ijaz Hospital"
NEXT_PUBLIC_APP_CITY="Lahore, Pakistan"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMS / WhatsApp Notification Gateway
# Options: "mock" (default for dev/test), "twilio", "generic_http"
SMS_PROVIDER="mock"

# Twilio Adapter Configuration (used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Generic HTTP Gateway Adapter (used when SMS_PROVIDER=generic_http)
# Supported Pakistani gateways (e.g., Brandverse, Telenor, Jazz SMS API)
GENERIC_SMS_ENDPOINT=""
GENERIC_SMS_API_KEY=""
GENERIC_SMS_SENDER_ID="NI-HOSPITAL"

# Backup & System Configuration
BACKUP_STORAGE_PATH="./backups"
RATE_LIMIT_MAX_REQUESTS="60"
RATE_LIMIT_WINDOW_MS="60000"
